# Copy to .env and fill in, or export these directly.

# One of: "groq" (verified end-to-end), "ollama" (fully local, no API key),
# "anthropic" (wired but unverified in this env), "gemini" (wired but the
# free-tier endpoint was 503-unavailable during testing).
ADHIKAR_MODEL_PROVIDER=groq

# groq: OpenAI-compatible endpoint; sign up at console.groq.com/keys (email only)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL_ID=openai/gpt-oss-120b

# ollama (fallback; see README caveats -- 7-8B local models tested don't
# handle the tool schema and consent-ask reliably)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1
# OLLAMA_NUM_GPU=0        # CPU default -- override with a positive int to
#                           re-enable GPU offload once your driver is fixed

# anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001

# gemini
# GEMINI_API_KEY=AQ....
# GEMINI_MODEL_ID=gemini-3.6-flash
