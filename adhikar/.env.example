# Copy to .env and fill in, or export these directly.

# "ollama" (default, fully local, no AWS account) or "anthropic"
ADHIKAR_MODEL_PROVIDER=ollama

# Only used when ADHIKAR_MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3.1

# Only used when ADHIKAR_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001
